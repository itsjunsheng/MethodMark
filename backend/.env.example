# Copy to .env. Health works without secrets; loading questions requires Supabase.
METHODMARK_APP_NAME=MethodMark API
METHODMARK_ENVIRONMENT=development
# JSON array of browser origins, without a path.
METHODMARK_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Server-only credentials for local sample-paper access.
METHODMARK_SUPABASE_URL=
METHODMARK_SUPABASE_SECRET_KEY=

# Grading worker
OPENAI_API_KEY=
# OPENROUTER_API_KEY=
METHODMARK_GRADING_PROVIDER=openai
METHODMARK_GRADING_VISION_MODEL=gpt-5.4-mini
METHODMARK_GRADING_MODEL=gpt-5.4-mini
