      ],
      "parts": [
        {
          "id": "part_a",
          "label": "(a)",
          "blocks": [
            {
              "type": "text",
              "text": "Find y when x = 4."
            }
          ]
        },
        {
          "id": "part_b",
          "label": "(b)",
          "blocks": [
            {
              "type": "text",
              "text": "Find x when y = 20."
            }
          ]
        }
      ]
    },
    "solution": {
      "parts": [
        {
          "part_id": "part_a",
          "worked_solution": [
            "y = 3(4) + 2",
            "y = 14"
          ]
        },
        {
          "part_id": "part_b",
          "worked_solution": [
            "20 = 3x + 2",
            "3x = 18",
            "x = 6"
          ]
        }
